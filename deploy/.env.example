# Kopie dieser Datei auf dem Server als deploy/.env ablegen und ausfüllen.

# Adressen - beide müssen per DNS auf die IP des Servers zeigen.
PROD_DOMAIN=sitzordnung.celik-soft.de
TEST_DOMAIN=test.sitzordnung.celik-soft.de

# Für die Zertifikate von Let's Encrypt (Ablaufwarnungen gehen dorthin).
ACME_EMAIL=ich@example.de

# Die Images werden von der GitHub-Actions-Pipeline gebaut und hierher gesetzt.
IMAGE_PROD=ghcr.io/v07gvo9/sitzordnung:master
IMAGE_TEST=ghcr.io/v07gvo9/sitzordnung:test

# Startpasswort: gilt nur beim allerersten Start, solange noch kein Konto
# existiert. Danach zählt ausschließlich das in der App gesetzte Passwort.
# Mindestens 10 Zeichen, sonst wird ein zufälliges erzeugt und ins Log geschrieben.
PROD_AUTH_USERNAME=lehrkraft
PROD_AUTH_INITIAL_PASSWORD=bitte-hier-etwas-langes-eintragen

TEST_AUTH_USERNAME=lehrkraft
TEST_AUTH_INITIAL_PASSWORD=bitte-hier-etwas-anderes-eintragen
