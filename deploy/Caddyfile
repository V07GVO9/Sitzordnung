# Caddy holt und erneuert die Zertifikate von Let's Encrypt automatisch.
{
	email {$ACME_EMAIL}
}

(gemeinsam) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN statt DENY: Die Microsoft-Anmeldung erneuert sich still in
		# einem versteckten Fenster, das auf die eigene Seite /auth zurückkehrt.
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		# Die Anwendung lädt alles von der eigenen Adresse. Ausnahme ist die
		# OneDrive-Ablage: Anmeldung bei Microsoft, Microsoft Graph und die
		# Download-Adressen von OneDrive (privat und Schule/SharePoint).
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://login.microsoftonline.com https://graph.microsoft.com https://*.sharepoint.com https://*.1drv.com https://*.livefilestore.com https://*.svc.ms; frame-src 'self' https://login.microsoftonline.com https://login.live.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'"
		-Server
	}
}

{$PROD_DOMAIN} {
	import gemeinsam
	reverse_proxy app-prod:8080
}

{$TEST_DOMAIN} {
	import gemeinsam
	reverse_proxy app-test:8080

	# Suchmaschinen sollen die Testumgebung nicht aufnehmen.
	header X-Robots-Tag "noindex, nofollow"
}
